    "CHIRP_DAILY_CAP": "30000",
    "GEMINI_DAILY_CAP": "20",
    "GEMINI_TTS_DAILY_CAP": "30"
  },
  "kv_namespaces": [
    {
      "binding": "QUOTA_KV",
      "id": "e093a7e26ac546c18c222198fe7e21cf"
    }
  ]
}
